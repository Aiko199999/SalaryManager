{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SalaryManager",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/SalaryManager/bin/Debug/net10.0/SalaryManager.dll",
      "args": [],
      "cwd": "${workspaceFolder}/SalaryManager",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5180"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
