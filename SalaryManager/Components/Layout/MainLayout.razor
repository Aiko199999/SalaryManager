@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-mark">S</div>
            <div>
                <strong>SalaryManager</strong>
                <span>Payroll workspace</span>
            </div>
        </div>

        <nav class="main-nav" aria-label="Main navigation">
            <span class="nav-label">WORKSPACE</span>
            <NavLink href="/" Match="NavLinkMatch.All"><span class="nav-icon">⌂</span> Overview</NavLink>
            <NavLink href="/employees"><span class="nav-icon">♙</span> Employees</NavLink>
            <NavLink href="/payroll"><span class="nav-icon">▤</span> Payroll</NavLink>
            <NavLink href="/history"><span class="nav-icon">◷</span> Payment history</NavLink>
            <NavLink href="/reports"><span class="nav-icon">▥</span> Reports</NavLink>
        </nav>

        <div class="sidebar-note">
            <span class="note-dot"></span>
            <div>
                <strong>Demo workspace</strong>
                <small>Sample payroll data</small>
            </div>
        </div>
    </aside>

    <main class="main-area">
        <header class="topbar">
            <div>
                <span class="eyebrow">PAYROLL MANAGEMENT</span>
                <div class="topbar-title">Salary overview</div>
            </div>
            <div class="topbar-right">
                <span class="today-label">@DateTime.Today.ToString("dddd, dd MMMM yyyy")</span>
                <div class="avatar">SM</div>
            </div>
        </header>
        <div class="page-content">
            @Body
        </div>
        <footer class="page-footer">
            SalaryManager <span>·</span> Academic project <span>·</span> Payroll figures are illustrative
        </footer>
    </main>
</div>
